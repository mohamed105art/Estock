            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); padding: 10px 0;
        }
        .circular-view.show { opacity: 1; transform: scale(1); }
        
        .donut-chart-wrapper {
            position: relative; width: 160px; height: 160px; flex-shrink: 0; border-radius: 50%;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2); display: flex; justify-content: center; align-items: center;
