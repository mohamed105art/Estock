<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>التقويم الإداري - لوحة القيادة</title>
    <!-- خطوط جوجل: تجوال -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <!-- مكتبة الأيقونات FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-color: #051A2D;
            /* باليت الألوان الحيوية */
            --color-1: #10BBC3;
            --color-2: #FEA24F;
            --color-3: #068187;
            --color-4: #A60E35;
            --color-5: #6A1B9A;
            --color-6: #108AB1;
            /* خلفية زجاجية */
            --glass-bg: linear-gradient(145deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
            --glass-border: rgba(255, 255, 255, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            /* خلفية جمالية خفيفة جداً لتعزيز الزجاجية */
            background-image: radial-gradient(circle at 50% 0%, rgba(16, 187, 195, 0.1) 0%, transparent 50%);
        }

        /* حاوية التقويم الزجاجية */
        .calendar-widget {
            width: 100%;
            max-width: 480px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-top: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3), inset 0 0 20px rgba(255,255,255,0.02);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 24px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* ترويسة التقويم (العنوان) */
        .widget-header {
            text-align: center;
            margin-bottom: 8px;
        }
        .widget-title {
            font-size: 1.4rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 4px;
        }
        .widget-subtitle {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.6);
            font-weight: 500;
        }

        /* شريط التنقل بين الأشهر */
        .cal-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 8px 16px;
        }
        .cal-month {
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.5px;
        }
        .nav-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.05);
        }

        /* شبكة أيام الأسبوع */
        .cal-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px; /* تم تقليص الفراغ لتصغير الأيام ومنع التجاوز */
            text-align: center;
        }
        .weekday {
            font-size: 0.75rem;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 8px;
        }

        /* تصميم أزرار الأيام */
        .cal-day {
            aspect-ratio: 1; /* مربع مثالي */
            border-radius: 12px; /* حواف دائرية جميلة */
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            display: flex;
            flex-direction: column;
            align-items: center; /* التمركز الأفقي */
            justify-content: flex-start; /* دفع رقم اليوم للأعلى */
            padding-top: 6px; /* مسافة قريبة من السقف العُلوي */
            position: relative;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            color: rgba(255, 255, 255, 0.9);
            font-weight: 600;
            font-size: 1rem;
        }

        /* الأيام من الأشهر الأخرى */
        .cal-day.inactive {
            color: rgba(255, 255, 255, 0.2);
            background: transparent;
            border-color: transparent;
        }

        /* تأثير المرور العادي */
        .cal-day:not(.inactive):hover {
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-3px);
        } /* تم إصلاح إغلاق القوس هنا - هذا ما تسبب في الأزمة! */

        /* تأثير المرور المبهج للأيام ذات العمليات */
        .cal-day.has-event:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--event-color);
            transform: translateY(-5px) scale(1.05);
            color: #fff;
        }

        /* الشارة العائمة الدائرية (البادج) للتدخلات */
        .event-badge {
            position: absolute;
            bottom: -1px; /* متلاصقة تماماً مع الحافة السفلية وتتجاوزها ببيكسل */
            right: -1px; /* متلاصقة تماماً مع الحافة اليمنى وتتجاوزها ببيكسل */
            width: 18px; 
            height: 18px;
            border-radius: 50%;
            background-color: var(--event-color);
            color: #fff;
            font-size: 0.6rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1; /* معادلة ارتفاع السطر */
            padding-top: 2px; /* ضبط المركز البصري للرقم ليكون في السنتر تماماً */
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 2;
        }

        /* قفزة الشارة عند التفاعل */
        .cal-day.has-event:hover .event-badge {
            transform: translateY(-2px) scale(1.1); /* إزالة التوسيط الأفقي السابق */
        }

        /* تمييز أيام العطلة (السبت والأحد) بلون غامق قليلاً */
        .cal-grid:last-child .cal-day:nth-child(7n+1), 
        .cal-grid:last-child .cal-day:nth-child(7n) { /* السبت (العمود الأخير) */
            background: rgba(0, 0, 0, 0.18);
            border-color: rgba(255, 255, 255, 0.02);
            color: rgba(255, 255, 255, 0.4);
        }
        .cal-grid:last-child .cal-day.has-event:nth-child(7n+1),
        .cal-grid:last-child .cal-day.has-event:nth-child(7n) {
            background: rgba(0, 0, 0, 0.25);
            color: rgba(255, 255, 255, 0.9);
        }

        @media (max-width: 400px) {
            .cal-day { font-size: 0.9rem; }
            .event-badge { width: 15px; height: 15px; font-size: 0.55rem; bottom: -1px; right: -1px; top: auto; }
        }
    </style>
</head>
