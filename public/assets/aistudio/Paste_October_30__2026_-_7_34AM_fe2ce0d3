        document.addEventListener('DOMContentLoaded', () => {
            const boxes = document.querySelectorAll('.glass-box');
            boxes.forEach(box => {
                const barBtn = box.querySelector('.fa-bars-staggered').parentElement;
                const circleBtn = box.querySelector('.fa-circle-dot').parentElement;
                
                barBtn.addEventListener('click', () => switchView(barBtn, 'bars'));
                circleBtn.addEventListener('click', () => switchView(circleBtn, 'circle'));
            });
        });

        function switchView(btn, viewType) {
            const box = btn.closest('.glass-box');
            const progList = box.querySelector('.progress-list');
            if (!progList) return;

            box.querySelectorAll('.ctrl-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            if (viewType === 'circle') {
                progList.style.display = 'none';
                let circleView = box.querySelector('.circular-view');
                
                if (!circleView) {
                    circleView = document.createElement('div');
                    circleView.className = 'circular-view';
                    
                    const items = box.querySelectorAll('.progress-item');
                    let stops = [];
                    let svgSlices = '';
                    let acc = 0;
                    let totalSum = 0;
                    let unitName = 'قطعة'; 
                    let legendHtml = '<div class="circle-legend">';
                    
                    items.forEach(item => {
                        const fill = item.querySelector('.prog-fill');
                        const widthVal = fill.style.getPropertyValue('--target-width').trim().replace('%', '');
                        const percent = parseFloat(widthVal) || 0;
                        const color = fill.style.backgroundColor;
                        
                        let labelText = item.querySelector('.prog-label-wrapper').innerText.trim();
                        let valText = item.querySelector('.prog-val').innerText.trim();
                        
                        const numMatch = valText.match(/(\d+)/);
                        const rawNum = numMatch ? parseInt(numMatch[1]) : 0;
                        totalSum += rawNum;
                        
                        if(valText.includes('إشهاد')) unitName = 'إشهاد';
                        
                        const percentMatch = valText.match(/\((.*?)\)/);
                        const percentVal = percentMatch ? percentMatch[1] : (percent + '%');
                        
                        // إضافة معرف فريد لكل شريحة لربطها بالمفتاح الخاص بها
                        const sliceId = 'slice-' + Math.random().toString(36).substr(2, 9);
                        
                        // بناء دوائر SVG التفاعلية لكل جزء
                        const r = 15.915494309; 
                        const offset = 100 - acc;
                        svgSlices += `<circle cx="21" cy="21" r="${r}" fill="transparent" stroke="${color}" stroke-width="6" stroke-dasharray="${percent} ${100 - percent}" stroke-dashoffset="${offset}" class="donut-slice" data-slice-id="${sliceId}" data-name="${labelText}" data-perc="${percentVal}" style="cursor: pointer; transition: all 0.2s ease; outline: none;"></circle>`;
                        
                        acc += percent;
                        
                        // تصميم المفتاح مع ربطه بالشريحة لمعرفة أي عنصر يجب إظهاره
                        legendHtml += `
                            <div class="legend-item" data-legend-id="${sliceId}">
                                <div class="legend-right">
                                    <div class="legend-color" style="background-color: ${color};"></div>
                                    <div class="legend-label" title="${labelText}">${labelText}</div>
                                </div>
                                <div class="legend-left">
                                    <span class="legend-num">${rawNum}</span> 
                                    <span class="legend-perc" dir="ltr">(${percentVal})</span>
                                </div>
                            </div>
                        `;
                    });
                    
                    if (acc < 100) { 
                        // ملء الفراغ المتبقي إن وجد
                        svgSlices += `<circle cx="21" cy="21" r="15.915494309" fill="transparent" stroke="rgba(255,255,255,0.03)" stroke-width="6" stroke-dasharray="${100 - acc} ${acc}" stroke-dashoffset="${100 - acc}" style="pointer-events: none;"></circle>`;
                    }
                    legendHtml += '</div>';

                    // تجميع الـ SVG
                    const svgChart = `
                        <svg viewBox="0 0 42 42" class="donut-chart-svg" style="width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; animation: rotateIn 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;">
                            ${svgSlices}
                        </svg>
                    `;
                    
                    circleView.innerHTML = `
                        <div class="donut-chart-wrapper" style="background: rgba(0,0,0,0.1);">
                            ${svgChart}
                            <div class="donut-inner">
                                <span class="donut-total">${totalSum}</span>
                                <span class="donut-unit">${unitName}</span>
                            </div>
                        </div>
                        ${legendHtml}
                    `;
                    box.appendChild(circleView);

                    // تفعيل تأثيرات اللمس والمرور بالماوس على المبيان الدائري
                    const inner = circleView.querySelector('.donut-inner');
                    const defaultTotalHtml = inner.innerHTML;
                    const slices = circleView.querySelectorAll('.donut-slice');
                    let activeSliceId = null; // لتخزين الشريحة النشطة حالياً عند الضغط

                    slices.forEach(slice => {
                        const sid = slice.getAttribute('data-slice-id');
                        
                        const updateCenterText = (targetSlice) => {
                            inner.innerHTML = `
                                <span class="donut-total" style="font-size: 1.3rem; color: ${targetSlice.getAttribute('stroke')}">${targetSlice.getAttribute('data-perc')}</span>
                                <span class="donut-unit" style="font-size: 0.65rem; text-align: center; padding: 0 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; line-height: 1.3;">${targetSlice.getAttribute('data-name')}</span>
                            `;
                        };

                        const handleHover = (e) => {
                            if(e && e.type !== 'mouseleave') e.preventDefault();
                            slices.forEach(s => s.style.opacity = '0.3');
                            slice.style.opacity = '1';
                            slice.style.strokeWidth = '8'; 
                            updateCenterText(slice);
                        };
                        
                        const handleLeave = () => {
                            if (activeSliceId) {
                                // إذا كان هناك لون مضغوط عليه، نعود لإظهار معلوماته عند إبعاد الماوس
                                const activeEl = circleView.querySelector(`.donut-slice[data-slice-id="${activeSliceId}"]`);
                                if(activeEl) {
                                    slices.forEach(s => s.style.opacity = '0.3');
                                    activeEl.style.opacity = '1';
                                    activeEl.style.strokeWidth = '8';
                                    updateCenterText(activeEl);
                                }
                            } else {
                                // وإلا نعود للوضع العادي (إظهار المجموع)
                                slices.forEach(s => { s.style.opacity = '1'; s.style.strokeWidth = '6'; });
                                inner.innerHTML = defaultTotalHtml; 
                            }
                        };

                        const handleClick = (e) => {
                            if(e) e.preventDefault();
                            const allLegends = circleView.querySelectorAll('.legend-item');
                            
                            if (activeSliceId === sid) {
                                // إلغاء التحديد عند الضغط مرة أخرى وإظهار جميع المفاتيح
                                activeSliceId = null;
                                allLegends.forEach(l => l.style.display = 'flex');
                                handleLeave();
                            } else {
                                // تحديد الشريحة وإخفاء الباقي
                                activeSliceId = sid;
                                allLegends.forEach(l => {
                                    if(l.getAttribute('data-legend-id') === sid) {
                                        l.style.display = 'flex';
                                    } else {
                                        l.style.display = 'none';
                                    }
                                });
                                handleHover();
                            }
                        };
                        
                        slice.addEventListener('mouseenter', handleHover);
                        slice.addEventListener('mouseleave', handleLeave);
                        slice.addEventListener('click', handleClick);
                        slice.addEventListener('touchstart', handleClick, {passive: false});
                    });
                }
                
                circleView.style.display = 'flex';
                setTimeout(() => circleView.classList.add('show'), 20);
                
            } else {
                const circleView = box.querySelector('.circular-view');
                if (circleView) {
                    circleView.classList.remove('show');
                    setTimeout(() => {
                        circleView.style.display = 'none';
                        progList.style.display = 'flex';
                    }, 300);
                } else {
                    progList.style.display = 'flex';
                }
            }
        }
    </script>
</body>
