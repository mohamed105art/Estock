            color: rgba(255, 255, 255, 0.7); display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.2s;
        }
        .ctrl-btn:hover { background: rgba(255, 255, 255, 0.15); color: #fff; }
        .ctrl-btn.active { background: rgba(59, 130, 246, 0.2); border-color: rgba(59, 130, 246, 0.5); color: #60a5fa; }

        /* أشرطة التقدم */
        .progress-list { display: flex; flex-direction: column; gap: 16px; }
        .progress-item { display: flex; flex-direction: column; gap: 8px; position: relative; }
        .progress-item:hover .prog-val { color: #fff; transform: translateX(-4px); }
        .prog-info { display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 500; transition: 0.3s; }
        .prog-label-wrapper { display: flex; align-items: center; gap: 8px; }
        .prog-val { color: rgba(255, 255, 255, 0.7); transition: 0.3s; }
        .prog-track { height: 8px; background: rgba(255, 255, 255, 0.05); border-radius: 6px; overflow: hidden; box-shadow: inset 0 1px 3px rgba(0,0,0,0.3); }
        .prog-fill { height: 100%; border-radius: 6px; position: relative; width: 0; animation: fillBar 1.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; overflow: hidden; }
        .prog-fill::after {
            content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0;
