        .tab-3 .step-title { color: var(--color-phase-3); }
        .tab-3 .step-number { background-color: var(--color-phase-3); }


        /* 4. محتوى المراحل (Dynamic Content) */
        .tab-content {
            display: none;
            animation: fadeIn 0.4s ease forwards;
        }
        .tab-content.active {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* العناوين داخل الأقسام */
        .section-header {
            display: flex;
