            --glass-hover: rgba(255, 255, 255, 0.08);
        }

        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
            font-family: 'Tajawal', sans-serif; 
            -webkit-tap-highlight-color: transparent; 
        }
        
        body { 
