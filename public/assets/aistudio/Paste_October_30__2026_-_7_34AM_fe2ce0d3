            color: #ffffff; 
            z-index: 3; 
            pointer-events: none; 
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease;
        }
        .metric-card:hover .card-icon { transform: translateY(-6px) rotate(-4deg) scale(1.15); opacity: 0.35; }
        .metric-card:active .card-icon { transform: translateY(-2px) rotate(-10deg) scale(1.05); transition-duration: 0.1s; }

        .card-footer { 
            position: absolute; bottom: 8px; right: 16px; left: 16px;
            display: flex; align-items: center; gap: 6px;
            font-size: 0.7rem; font-weight: 400; color: rgba(255, 255, 255, 0.85); z-index: 4; 
        }
        .trend-up { background: linear-gradient(135deg, rgba(76,175,80,0.3), rgba(76,175,80,0.45)); color: #a5f3fc; border: 1px solid rgba(76,175,80,0.3); }
        .trend-down { background: linear-gradient(135deg, rgba(229,57,53,0.3), rgba(229,57,53,0.45)); color: #ffebee; border: 1px solid rgba(229,57,53,0.3); }
        .trend-neutral { background: linear-gradient(135deg, rgba(158,158,158,0.2), rgba(158,158,158,0.35)); color: #f5f5f5; border: 1px solid rgba(158,158,158,0.2); }

        /* الأيقونات المائية العميقة والتفاعلية */
        .card-icon { 
            position: absolute; 
            left: 15px; 
            bottom: 10px; /* تم رفعها بـ 15 بكسل كما أمرت */
            font-size: 3.5rem; 
            opacity: 0.15; 
            transform: rotate(-12deg); 
            color: #ffffff; 
            z-index: 3; 
            pointer-events: none; 
            /* الترانزيشن يضمن عودة الأيقونة لمكانها عند إفلات الماوس */
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease;
        }
        .metric-card:hover .card-icon { transform: translateY(-8px) rotate(-4deg) scale(1.15); opacity: 0.35; }
        .metric-card:active .card-icon { transform: translateY(-2px) rotate(-10deg) scale(1.05); transition-duration: 0.1s; }

        .card-footer { 
            position: absolute; bottom: 12px; right: 20px; left: 20px;
            display: flex; align-items: center; gap: 6px;
            font-size: 0.75rem; font-weight: 400; color: rgba(255, 255, 255, 0.85); z-index: 4; 
        }

        /* -------------------------------------------
           2. قسم الإحصائيات (الزجاجي المميز)
           ------------------------------------------- */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 20px; }

        .glass-box {
            /* تدرج لوني فاتح وباهت لتمييز الإحصائيات */
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.01) 100%);
            border: 1px solid rgba(255, 255, 255, 0.15);
