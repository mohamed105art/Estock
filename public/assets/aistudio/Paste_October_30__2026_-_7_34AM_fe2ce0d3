        }
        @keyframes fillBar { to { width: var(--target-width); } }
        @keyframes shimmerProg { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }

        /* المبيان الدائري (Donut Chart) المطابق للتصميم المطلوب */
        .circular-view {
