        /* ألوان التبويبات المخصصة (بدون توهج) */
        .tab-1.active { border-color: var(--color-phase-1); background: linear-gradient(135deg, rgba(254, 162, 79, 0.1), rgba(255,255,255,0.02)); }
        .tab-1 .step-title { color: var(--color-phase-1); }
