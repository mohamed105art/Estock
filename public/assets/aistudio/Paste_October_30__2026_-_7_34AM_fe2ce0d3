        .card-4 { background: linear-gradient(270deg, var(--color-card-4) 0%, rgba(166, 14, 53, 0.3) 65%, rgba(5, 26, 45, 0.6) 100%); }
        .card-5 { background: linear-gradient(270deg, var(--color-card-5) 0%, rgba(106, 27, 154, 0.3) 65%, rgba(5, 26, 45, 0.6) 100%); }
        .card-6 { background: linear-gradient(270deg, var(--color-card-6) 0%, rgba(16, 138, 177, 0.3) 65%, rgba(5, 26, 45, 0.6) 100%); }

        .card-header { display: flex; justify-content: flex-start; align-items: center; position: relative; z-index: 2;}
