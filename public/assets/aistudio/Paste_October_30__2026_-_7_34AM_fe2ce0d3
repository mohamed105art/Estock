            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            opacity: 0.6;
        }
        .step-tab:hover { opacity: 0.8; transform: translateY(-2px); }
        
        .step-tab.active {
            opacity: 1;
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }
        
        .step-info {
            display: flex;
